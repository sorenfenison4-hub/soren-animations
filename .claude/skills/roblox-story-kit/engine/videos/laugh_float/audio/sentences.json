[
 {
  "text": "I laughed at one joke in class, and floated straight out of the school window!",
  "start": 0.0,
  "end": 2.691,
  "startFrame": 0,
  "endFrame": 81,
  "words": [
   0,
   14
  ]
 },
 {
  "text": "Then my best friend laughed too!",
  "start": 2.898,
  "end": 3.896,
  "startFrame": 87,
  "endFrame": 117,
  "words": [
   15,
   20
  ]
 },
 {
  "text": "He flew right after me!",
  "start": 4.009,
  "end": 4.95,
  "startFrame": 120,
  "endFrame": 148,
  "words": [
   21,
   25
  ]
 },
 {
  "text": "You see, in this world, laughing makes you lighter than air.",
  "start": 5.082,
  "end": 7.152,
  "startFrame": 152,
  "endFrame": 215,
  "words": [
   26,
   36
  ]
 },
 {
  "text": "The harder you laugh, the higher you float.",
  "start": 7.284,
  "end": 8.639,
  "startFrame": 219,
  "endFrame": 259,
  "words": [
   37,
   44
  ]
 },
 {
  "text": "That's why comedy clubs have nets on the ceiling.",
  "start": 8.752,
  "end": 10.239,
  "startFrame": 263,
  "endFrame": 307,
  "words": [
   45,
   53
  ]
 },
 {
  "text": "Pilots aren't allowed to watch cartoons.",
  "start": 10.389,
  "end": 11.669,
  "startFrame": 312,
  "endFrame": 350,
  "words": [
   54,
   59
  ]
 },
 {
  "text": "And my grandma wears ankle weights to watch her favorite show.",
  "start": 11.782,
  "end": 13.796,
  "startFrame": 353,
  "endFrame": 414,
  "words": [
   60,
   70
  ]
 },
 {
  "text": "But I have a problem.",
  "start": 13.909,
  "end": 14.793,
  "startFrame": 417,
  "endFrame": 444,
  "words": [
   71,
   75
  ]
 },
 {
  "text": "I laugh at everything.",
  "start": 14.925,
  "end": 15.904,
  "startFrame": 448,
  "endFrame": 477,
  "words": [
   76,
   79
  ]
 },
 {
  "text": "And yesterday, my school had its first ever Joke Day.",
  "start": 16.073,
  "end": 18.125,
  "startFrame": 482,
  "endFrame": 544,
  "words": [
   80,
   89
  ]
 },
 {
  "text": "Our teacher, Mr.",
  "start": 18.219,
  "end": 18.84,
  "startFrame": 547,
  "endFrame": 565,
  "words": [
   90,
   92
  ]
 },
 {
  "text": "Pickle, told the first joke.",
  "start": 18.915,
  "end": 19.838,
  "startFrame": 567,
  "endFrame": 595,
  "words": [
   93,
   97
  ]
 },
 {
  "text": "Why was the math book sad?",
  "start": 19.95,
  "end": 20.967,
  "startFrame": 598,
  "endFrame": 629,
  "words": [
   98,
   103
  ]
 },
 {
  "text": "It had too many problems!",
  "start": 21.08,
  "end": 22.247,
  "startFrame": 632,
  "endFrame": 667,
  "words": [
   104,
   108
  ]
 },
 {
  "text": "Nobody laughed.",
  "start": 22.472,
  "end": 23.131,
  "startFrame": 674,
  "endFrame": 694,
  "words": [
   109,
   110
  ]
 },
 {
  "text": "Except me.",
  "start": 23.244,
  "end": 23.79,
  "startFrame": 697,
  "endFrame": 714,
  "words": [
   111,
   112
  ]
 },
 {
  "text": "I snorted, and my feet lifted off the floor!",
  "start": 23.884,
  "end": 25.71,
  "startFrame": 717,
  "endFrame": 771,
  "words": [
   113,
   121
  ]
 },
 {
  "text": "I grabbed my desk, but my best friend Leo saw my face and burst out laughing.",
  "start": 25.823,
  "end": 28.721,
  "startFrame": 775,
  "endFrame": 862,
  "words": [
   122,
   137
  ]
 },
 {
  "text": "He shot straight up and bonked his head on the ceiling!",
  "start": 28.872,
  "end": 30.66,
  "startFrame": 866,
  "endFrame": 920,
  "words": [
   138,
   148
  ]
 },
 {
  "text": "Bonk!",
  "start": 30.829,
  "end": 31.111,
  "startFrame": 925,
  "endFrame": 933,
  "words": [
   149,
   149
  ]
 },
 {
  "text": "That made the whole class laugh.",
  "start": 31.243,
  "end": 32.448,
  "startFrame": 937,
  "endFrame": 973,
  "words": [
   150,
   155
  ]
 },
 {
  "text": "Thirty kids floated up like balloons.",
  "start": 32.636,
  "end": 34.085,
  "startFrame": 979,
  "endFrame": 1023,
  "words": [
   156,
   161
  ]
 },
 {
  "text": "Backpacks, pencils, and Mr.",
  "start": 34.377,
  "end": 35.459,
  "startFrame": 1031,
  "endFrame": 1064,
  "words": [
   162,
   165
  ]
 },
 {
  "text": "Pickle's toupee went flying everywhere.",
  "start": 35.497,
  "end": 36.946,
  "startFrame": 1065,
  "endFrame": 1108,
  "words": [
   166,
   170
  ]
 },
 {
  "text": "Then the window popped open.",
  "start": 37.153,
  "end": 38.245,
  "startFrame": 1115,
  "endFrame": 1147,
  "words": [
   171,
   175
  ]
 },
 {
  "text": "Whoosh!",
  "start": 38.433,
  "end": 38.734,
  "startFrame": 1153,
  "endFrame": 1162,
  "words": [
   176,
   176
  ]
 },
 {
  "text": "The wind sucked us all outside.",
  "start": 38.866,
  "end": 40.202,
  "startFrame": 1166,
  "endFrame": 1206,
  "words": [
   177,
   182
  ]
 },
 {
  "text": "We floated over the playground, over the school, over the entire town.",
  "start": 40.353,
  "end": 43.176,
  "startFrame": 1211,
  "endFrame": 1295,
  "words": [
   183,
   194
  ]
 },
 {
  "text": "Leo was laughing even harder.",
  "start": 43.326,
  "end": 44.569,
  "startFrame": 1300,
  "endFrame": 1337,
  "words": [
   195,
   199
  ]
 },
 {
  "text": "Stop laughing!",
  "start": 44.738,
  "end": 45.434,
  "startFrame": 1342,
  "endFrame": 1363,
  "words": [
   200,
   201
  ]
 },
 {
  "text": "I can't!",
  "start": 45.604,
  "end": 46.187,
  "startFrame": 1368,
  "endFrame": 1386,
  "words": [
   202,
   203
  ]
 },
 {
  "text": "It tickles up here!",
  "start": 46.225,
  "end": 47.109,
  "startFrame": 1387,
  "endFrame": 1413,
  "words": [
   204,
   207
  ]
 },
 {
  "text": "A pigeon landed on his head, and he giggled so hard he shot into a cloud.",
  "start": 47.185,
  "end": 50.102,
  "startFrame": 1416,
  "endFrame": 1503,
  "words": [
   208,
   223
  ]
 },
 {
  "text": "Down below, the whole town was watching.",
  "start": 50.271,
  "end": 51.89,
  "startFrame": 1508,
  "endFrame": 1557,
  "words": [
   224,
   230
  ]
 },
 {
  "text": "And they thought it was hilarious.",
  "start": 51.965,
  "end": 53.151,
  "startFrame": 1559,
  "endFrame": 1595,
  "words": [
   231,
   236
  ]
 },
 {
  "text": "Big mistake.",
  "start": 53.433,
  "end": 53.904,
  "startFrame": 1603,
  "endFrame": 1617,
  "words": [
   237,
   238
  ]
 },
 {
  "text": "A thousand people floated up at once.",
  "start": 54.111,
  "end": 55.598,
  "startFrame": 1623,
  "endFrame": 1668,
  "words": [
   239,
   245
  ]
 },
 {
  "text": "Cars, dogs, even the mayor!",
  "start": 55.598,
  "end": 57.066,
  "startFrame": 1668,
  "endFrame": 1712,
  "words": [
   246,
   250
  ]
 },
 {
  "text": "The entire town was drifting into the sky.",
  "start": 57.254,
  "end": 59.042,
  "startFrame": 1718,
  "endFrame": 1771,
  "words": [
   251,
   258
  ]
 },
 {
  "text": "There was only one person still on the ground.",
  "start": 59.211,
  "end": 60.774,
  "startFrame": 1776,
  "endFrame": 1823,
  "words": [
   259,
   267
  ]
 },
 {
  "text": "Grumpy Gus.",
  "start": 60.999,
  "end": 61.489,
  "startFrame": 1830,
  "endFrame": 1845,
  "words": [
   268,
   269
  ]
 },
 {
  "text": "The only kid in history who had never laughed.",
  "start": 61.715,
  "end": 63.559,
  "startFrame": 1851,
  "endFrame": 1907,
  "words": [
   270,
   278
  ]
 },
 {
  "text": "Not once.",
  "start": 63.766,
  "end": 64.18,
  "startFrame": 1913,
  "endFrame": 1925,
  "words": [
   279,
   280
  ]
 },
 {
  "text": "He was so heavy, his shoes left craters in the sidewalk.",
  "start": 64.35,
  "end": 66.514,
  "startFrame": 1930,
  "endFrame": 1995,
  "words": [
   281,
   291
  ]
 },
 {
  "text": "Then I noticed something.",
  "start": 66.74,
  "end": 67.606,
  "startFrame": 2002,
  "endFrame": 2028,
  "words": [
   292,
   295
  ]
 },
 {
  "text": "Gus was the heaviest kid in the world.",
  "start": 67.737,
  "end": 69.337,
  "startFrame": 2032,
  "endFrame": 2080,
  "words": [
   296,
   303
  ]
 },
 {
  "text": "So I grabbed the mayor's tie.",
  "start": 69.469,
  "end": 70.429,
  "startFrame": 2084,
  "endFrame": 2113,
  "words": [
   304,
   309
  ]
 },
 {
  "text": "Leo grabbed my shoe.",
  "start": 70.579,
  "end": 71.276,
  "startFrame": 2117,
  "endFrame": 2138,
  "words": [
   310,
   313
  ]
 },
 {
  "text": "A thousand people grabbed each other.",
  "start": 71.426,
  "end": 72.687,
  "startFrame": 2143,
  "endFrame": 2181,
  "words": [
   314,
   319
  ]
 },
 {
  "text": "We made the longest human chain ever.",
  "start": 72.781,
  "end": 74.457,
  "startFrame": 2183,
  "endFrame": 2234,
  "words": [
   320,
   326
  ]
 },
 {
  "text": "Gus!",
  "start": 74.645,
  "end": 74.852,
  "startFrame": 2239,
  "endFrame": 2246,
  "words": [
   327,
   327
  ]
 },
 {
  "text": "Catch!",
  "start": 75.04,
  "end": 75.247,
  "startFrame": 2251,
  "endFrame": 2257,
  "words": [
   328,
   328
  ]
 },
 {
  "text": "He caught the end and pulled.",
  "start": 75.435,
  "end": 76.508,
  "startFrame": 2263,
  "endFrame": 2295,
  "words": [
   329,
   334
  ]
 },
 {
  "text": "Hard.",
  "start": 76.574,
  "end": 76.903,
  "startFrame": 2297,
  "endFrame": 2307,
  "words": [
   335,
   335
  ]
 },
 {
  "text": "We all came down like a giant kite.",
  "start": 77.092,
  "end": 78.597,
  "startFrame": 2313,
  "endFrame": 2358,
  "words": [
   336,
   343
  ]
 },
 {
  "text": "Everybody landed safely.",
  "start": 78.748,
  "end": 79.708,
  "startFrame": 2362,
  "endFrame": 2391,
  "words": [
   344,
   346
  ]
 },
 {
  "text": "The whole town cheered for Gus.",
  "start": 79.821,
  "end": 81.176,
  "startFrame": 2395,
  "endFrame": 2435,
  "words": [
   347,
   352
  ]
 },
 {
  "text": "And for the first time in his life, Gus smiled.",
  "start": 81.27,
  "end": 83.039,
  "startFrame": 2438,
  "endFrame": 2491,
  "words": [
   353,
   362
  ]
 },
 {
  "text": "Then he laughed.",
  "start": 83.152,
  "end": 84.131,
  "startFrame": 2495,
  "endFrame": 2524,
  "words": [
   363,
   365
  ]
 },
 {
  "text": "Uh oh.",
  "start": 84.319,
  "end": 84.62,
  "startFrame": 2530,
  "endFrame": 2539,
  "words": [
   366,
   367
  ]
 },
 {
  "text": "Whoosh!",
  "start": 84.902,
  "end": 85.26,
  "startFrame": 2547,
  "endFrame": 2558,
  "words": [
   368,
   368
  ]
 },
 {
  "text": "Gus rocketed straight into space.",
  "start": 85.448,
  "end": 86.766,
  "startFrame": 2563,
  "endFrame": 2603,
  "words": [
   369,
   373
  ]
 },
 {
  "text": "Somebody tell him something sad!",
  "start": 87.029,
  "end": 88.14,
  "startFrame": 2611,
  "endFrame": 2644,
  "words": [
   374,
   378
  ]
 }
]