[
 {
  "text": "I sneezed in class, and teleported into the cockpit of a flying plane!",
  "start": 0.0,
  "end": 2.649,
  "startFrame": 0,
  "endFrame": 79,
  "words": [
   0,
   12
  ]
 },
 {
  "text": "Then the pilot sneezed too!",
  "start": 2.83,
  "end": 3.785,
  "startFrame": 85,
  "endFrame": 114,
  "words": [
   13,
   17
  ]
 },
 {
  "text": "He vanished, and now I was flying the plane!",
  "start": 3.893,
  "end": 5.533,
  "startFrame": 117,
  "endFrame": 166,
  "words": [
   18,
   26
  ]
 },
 {
  "text": "You see, in this world, every time you sneeze, you teleport somewhere random.",
  "start": 5.695,
  "end": 8.272,
  "startFrame": 171,
  "endFrame": 248,
  "words": [
   27,
   39
  ]
 },
 {
  "text": "That's why pepper is illegal.",
  "start": 8.38,
  "end": 9.227,
  "startFrame": 251,
  "endFrame": 277,
  "words": [
   40,
   44
  ]
 },
 {
  "text": "Florists wear space suits.",
  "start": 9.408,
  "end": 10.363,
  "startFrame": 282,
  "endFrame": 311,
  "words": [
   45,
   48
  ]
 },
 {
  "text": "And my uncle sneezed during his driving test, and landed on the moon.",
  "start": 10.489,
  "end": 12.76,
  "startFrame": 315,
  "endFrame": 383,
  "words": [
   49,
   61
  ]
 },
 {
  "text": "He still failed.",
  "start": 12.886,
  "end": 13.463,
  "startFrame": 387,
  "endFrame": 404,
  "words": [
   62,
   64
  ]
 },
 {
  "text": "But I'm allergic to everything.",
  "start": 13.517,
  "end": 14.598,
  "startFrame": 406,
  "endFrame": 438,
  "words": [
   65,
   69
  ]
 },
 {
  "text": "And yesterday, my teacher, Miss Whiskers, brought her cat to class.",
  "start": 14.796,
  "end": 17.085,
  "startFrame": 444,
  "endFrame": 513,
  "words": [
   70,
   80
  ]
 },
 {
  "text": "The cat jumped on my desk.",
  "start": 17.193,
  "end": 18.148,
  "startFrame": 516,
  "endFrame": 544,
  "words": [
   81,
   86
  ]
 },
 {
  "text": "My nose started tingling.",
  "start": 18.257,
  "end": 19.14,
  "startFrame": 548,
  "endFrame": 574,
  "words": [
   87,
   90
  ]
 },
 {
  "text": "Ah...",
  "start": 19.545,
  "end": 19.888,
  "startFrame": 586,
  "endFrame": 597,
  "words": [
   91,
   91
  ]
 },
 {
  "text": "ah...",
  "start": 20.05,
  "end": 20.194,
  "startFrame": 602,
  "endFrame": 606,
  "words": [
   92,
   92
  ]
 },
 {
